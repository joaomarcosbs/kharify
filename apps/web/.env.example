# URL pública da API acessível pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3080/v1

# URL interna para chamadas Server-Side / Server Actions (Next.js SSR)
INTERNAL_API_URL=http://localhost:3080/v1

# (Opcional) Google OAuth Client ID — necessário somente se você quiser habilitar o login com Google.
# Crie um projeto em https://console.cloud.google.com e gere um OAuth 2.0 Client ID.
# Se não configurado, o botão "Continuar com Google" ficará oculto automaticamente.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
