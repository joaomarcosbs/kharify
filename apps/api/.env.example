# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://postgres:password@localhost:5432/kharify?schema=public

# Use a long, random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

PORT=3080
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:3000

# Optional. Without both credentials, Pluggy uses its sandbox fallback.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Optional. Enable Google OAuth Login for self-hosted instances.
GOOGLE_CLIENT_ID=
