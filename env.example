# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA deve ser versionado.
#
# Gere valores aleatórios com:
#   openssl rand -hex 24   (senha do banco)
#   openssl rand -hex 32   (JWT_SECRET)

# Senha do PostgreSQL. Use só letras e números, porque ela entra numa URL de conexão.
POSTGRES_PASSWORD=

# Segredo usado para assinar os tokens de login. Mantenha em sigilo.
JWT_SECRET=

# Tempo de validade do token (opcional, o padrão é 7d)
JWT_EXPIRES_IN=7d
